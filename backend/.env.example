NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://hyperverse:hyperverse_password@postgres:5432/hyperverse_cloud?schema=public
JWT_SECRET=replace_with_at_least_32_characters_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=replace_with_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

REDIS_URL=redis://redis:6379
