NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://hyperverse:change_me_postgres_password@postgres:5432/hyperverse_cloud?schema=public
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=https://example.com
DISCORD_CLIENT_ID=replace_me
DISCORD_CLIENT_SECRET=replace_me
DISCORD_REDIRECT_URI=https://example.com/api/auth/discord/callback
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
